{
    "name": "kdb/drupal-agentic-blueprint",
    "description": "Reutilizable blueprint para proyectos Drupal 11 (incluye Drupal CMS) con arquitectura multiagente y calidad de código determinística optimizada para Claude Code.",
    "type": "composer-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Yeison A. Suarez",
            "email": "yasuarezclavijo@gmail.com"
        }
    ],
    "keywords": [
        "drupal",
        "drupal-cms",
        "drupal-11",
        "quality-gates",
        "phpcs",
        "phpstan",
        "grumphp",
        "claude-code",
        "ai-assisted-development",
        "multiagent"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/yasuarezclavijo/kadabra-core"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.0",
        "kadabrait_uy/kadabra-core": "^1.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "drupal/coder": "^9.0",
        "mglaman/phpstan-drupal": "^2.0",
        "phpro/grumphp": "^2.21",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0",
        "friendsoftwig/twigcs": "^6.6"
    },
    "autoload": {
        "psr-4": {
            "DrupalAgenticBlueprint\\": "src/"
        }
    },
    "extra": {
        "class": "DrupalAgenticBlueprint\\ComposerPlugin"
    }
}
