<?xml version="1.0"?>
<ruleset name="Drupal CMS">
    <description>PHP CodeSniffer configuration for Drupal CMS 11 custom code.</description>

    <!-- Set global properties -->
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="report" value="full"/>
    <arg name="extensions" value="inc,install,js,css,scss,module,php,profile,theme,info,yml"/>
    <arg name="report-width" value="120"/>

    <!-- Use only Drupal standards (no external dependencies) -->
    <rule ref="PSR12"/>

    <!-- Files to check -->
    <file>web/modules/custom</file>
    <file>web/themes/custom</file>
    <file>web/profiles/custom</file>

    <!-- Ignore paths -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/libraries/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>web/sites/*/settings.php</exclude-pattern>

</ruleset>